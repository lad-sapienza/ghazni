# build output
dist/
.astro/
coverage/

# fetched fresh by `npm run build` (scripts/fetch-images.mjs) from the live
# BraDypUS API every time — thousands of finds/record photos, several GB;
# never committed, see README "For staff/future maintainers"
public/images/bdus/

# on-disk API response cache bridging fetch-images.mjs and astro build
# within one `npm run build` run — wiped and repopulated on every run
.bdus-cache/

# generated by scripts/export-blog-for-import.mjs — regeneratable from
