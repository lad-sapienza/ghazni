    "bootstrap": "^5.3.8",
    "maplibre-gl": "^6.7.0",
    "probe-image-size": "^7.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-slug": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
