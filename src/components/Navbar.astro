---
import BSNavbar from '@lad-sapienza/scms-core/components/BSNavbar';
import { menuForDomain, type Domain } from '../utils/menus';

interface Props {
  domain?: Domain;
  isHome?: boolean;
}

const { domain, isHome = false } = Astro.props;
const menuItems = menuForDomain(domain);
const currentPath = Astro.url.pathname;
---

<div class:list={['ghazni-nav-wrap position-relative', { 'sticky-top': !isHome }]}>
  <BSNavbar
    client:load
    menuItems={menuItems}
    currentPath={currentPath}
    cssClasses={{ nav: 'ghazni-nav', ul: 'ms-auto' }}
    brand={{ text: 'Ghazni', link: '/', cssClasses: 'ghazni-brand' }}
  />

  {!isHome && (
    // A plain Bootstrap .container, so it tracks the exact same width/
    // centering as BSNavbar's own internal .container at every breakpoint
    // (see ghazni.less .ghazni-search — anchoring to the full-bleed wrap
    // instead of this used a fixed offset from the *viewport* edge, which
    // drifted out of sync with the toggler whenever the two containers'
    // gutters differed, e.g. just below @nav-collapse-bp).
    <div class="container ghazni-search-slot">
      <form class="ghazni-search" action="#" id="search_db">
        <input
          type="search"
          placeholder="Search by inventory"
          class="form-control form-control-sm"
          id="input_search_db"
        />
      </form>
    </div>
  )}
</div>

<script>
  const form = document.getElementById('search_db') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('input_search_db') as HTMLInputElement | null;
    const value = input?.value.trim();
    if (value) {
      window.location.href = `/search?q=${encodeURIComponent(value)}`;
    }
  });
</script>
