---
// Renders an inline data query embedded directly in article prose (outside
// the taxonomy pages, which use FindsGrid/FuncomplexGrid/BiblioList
// directly with a known context) — was [[browseData]]...[[/browseData]] in
// the original site. Dispatches on the table named in the query.
import { bdusQueryFull, type BdusQuery } from '../../utils/bdus';
import { findUrl } from '../../utils/recordIndex';
import FindsGrid from './FindsGrid.astro';
import FuncomplexGrid from './FuncomplexGrid.astro';
import BiblioList from './BiblioList.astro';

interface Props {
  query: BdusQuery;
}
const { query } = Astro.props;
const records = await bdusQueryFull(query);
---

{query.tb === 'bibliography' && <BiblioList records={records} />}
{query.tb === 'funcomplex' && <FuncomplexGrid records={records} recordHrefBase="/islamic/funerary-complexes" />}
{query.tb === 'finds' && (
  <FindsGrid records={records} hrefFor={(invNo) => findUrl(invNo)} />
)}
