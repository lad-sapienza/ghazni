---
import '../styles/global.css';
import '../styles/ghazni.less';
import SEO from '@lad-sapienza/scms-core/components/SEO/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { siteMetadata } from '../user.config.mjs';
import type { Domain } from '../utils/menus';

interface Props {
  title?: string;
  description?: string;
  domain?: Domain;
  isHome?: boolean;
}

const { title = siteMetadata.title, description = siteMetadata.description, domain, isHome = false } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <link rel="shortcut icon" href="/images/css/favicon.png" />
    <SEO title={title} description={description} siteMetadata={siteMetadata} />
    <slot name="head" />
    <script is:inline>
      /* Ghazni never had a dark mode — pin scms-core's theme system to light. */
      try {
        localStorage.setItem('scms-theme', 'light');
      } catch (e) {}
      document.documentElement.setAttribute('data-bs-theme', 'light');
    </script>
  </head>

  <body class:list={['d-flex flex-column min-vh-100', { 'is-home': isHome }]}>
    <Navbar domain={domain} isHome={isHome} />

    <main class="flex-grow-1">
      <slot />
    </main>

    <Footer />

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      defer
      is:inline></script>
  </body>
</html>
