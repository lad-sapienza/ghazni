---
import { getCollection, render } from 'astro:content';
import ArticlePage from '../components/ArticlePage.astro';
import BlogPostPage from '../components/BlogPostPage.astro';
import { listPublishedPosts } from '../utils/blog';

// The domain-prefixed variants of some of these same articles (e.g.
// /islamic/funerary-complexes) are generated by src/pages/[domain]/[article].astro
// instead — see DOMAIN_ARTICLE_PATHS there. Both are real URLs on the
// original site (a routing quirk, not a design), so both are kept.
//
// Blog posts (from BraDypUS, see src/utils/blog.ts) are included here too:
// the original PHP site served them at a bare /{textid} URL in addition to
// /blog/{textid} (verified against the live legacy site), so this route
// still needs to know about both articles AND posts, tagging each static
// path with which one it is since the two need different detail templates.
export async function getStaticPaths() {
  const [articles, posts] = await Promise.all([getCollection('articles'), listPublishedPosts()]);
  const latestPosts = posts.slice(0, 5);
  return [
    ...articles.map((entry) => ({
      params: { textid: entry.data.textid },
      props: { kind: 'article' as const, entry },
    })),
    ...posts.map((post) => ({
      params: { textid: post.slug },
      props: { kind: 'post' as const, post, latestPosts },
    })),
  ];
}

const props = Astro.props;
const Content = props.kind === 'article' ? (await render(props.entry)).Content : undefined;
---

{props.kind === 'article' ? (
  <ArticlePage entry={props.entry} Content={Content} />
) : (
  <BlogPostPage post={props.post} latestPosts={props.latestPosts} />
)}
