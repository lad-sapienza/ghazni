---
import { render } from 'astro:content';
import ArticlePage from '../components/ArticlePage.astro';
import { getAllTextidPages } from '../utils/content';

// The domain-prefixed variants of some of these same articles (e.g.
// /islamic/funerary-complexes) are generated by src/pages/[domain]/[article].astro
// instead — see DOMAIN_ARTICLE_PATHS there. Both are real URLs on the
// original site (a routing quirk, not a design), so both are kept.
export async function getStaticPaths() {
  const articles = await getAllTextidPages();
  return articles.map((entry) => ({ params: { textid: entry.data.textid }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ArticlePage entry={entry} Content={Content} />
