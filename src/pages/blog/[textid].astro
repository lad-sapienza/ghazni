---
import BlogPostPage from '../../components/BlogPostPage.astro';
import { listPublishedPosts } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await listPublishedPosts();
  const latestPosts = posts.slice(0, 5);
  return posts.map((post) => ({ params: { textid: post.slug }, props: { post, latestPosts } }));
}

const { post, latestPosts } = Astro.props;
---

<BlogPostPage post={post} latestPosts={latestPosts} />
