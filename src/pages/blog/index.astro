---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listPublishedPosts } from '../../utils/blog';
import { localFileUrl } from '../../utils/localImages';

const posts = await listPublishedPosts();
---

<BaseLayout title="Blog">
  <div class="submenu"><div class="container"><h1>Blog</h1></div></div>

  <div class="container my-5 py-5">
    <div class="blog">
      {posts.map((post) => (
        <article class="blog-item">
          <h3>{post.title}</h3>
          <hr />
          <p class="text-secondary">
            Posted{post.author && ` by ${post.author}`}{post.publishDate && ` on ${post.publishDate}`}
          </p>
          <div class="row">
            <div class="col-sm-6">
              {post.coverFile && (
                <img
                  src={localFileUrl(post.coverFile.id, post.coverFile.ext)}
                  class="img-fluid"
                  alt={post.title}
                />
              )}
            </div>
            <div class="col-sm-6">
              {post.summary && <p>{post.summary}</p>}
              <p class="text-center mt-5">
                <a class="button" href={`/blog/${post.slug}`} title={post.title}>Read all</a>
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
